---
import Layout from "../layouts/Layout.astro";
import PlayerBar from "../components/home/PlayerBar.astro";
import { icons } from "../components/home/icons";
import "../styles/home.css";

const site = "https://www.estampasandinas.com";
const text = encodeURIComponent("Escucha Estampas Andinas");
const url = encodeURIComponent(site);
const social = [
  { label: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${url}`, bg: "#1565D8", fg: "#FFFFFF", icon: icons.facebook },
  { label: "WhatsApp", href: `https://wa.me/?text=${text}%20${url}`, bg: "#25D366", fg: "#0B2A17", icon: icons.whatsapp },
];
---

<Layout title="Estampas Andinas | Radio de música andina y huaynos en vivo">
  <div class="ea-page" id="top" data-page>
    <a class="ea-skip" href="#escuchar">Saltar al contenido</a>

    <header class="ea-wrap ea-header">
      <a href="#top" class="ea-logo">Estampas Andinas</a>
      <nav class="ea-nav" aria-label="Principal">
        <a href="#anteriores" data-has-episodes hidden>Programas anteriores</a>
        <a href="#programacion">Horario</a>
      </nav>
      <div class="ea-m-top">
        <span class="ea-m-label">Radio por internet</span>
        <span class="ea-chip ea-chip-pill" data-pill
          ><span class="ea-live-dot ea-pulse" data-pill-dot hidden></span><span data-pill-text>MÚSICA 24 H</span></span
        >
      </div>
    </header>

    <main id="escuchar" class="ea-wrap ea-main">
      <noscript>
        <p class="ea-noscript">
          Para escuchar la radio desde esta página necesitas activar JavaScript. También puedes
          <a href="https://radio.estampasandinas.com/public/estampas_andinas">abrir el reproductor de Estampas Andinas</a>
          directamente.
        </p>
      </noscript>
      <section class="ea-hero" aria-labelledby="titulo">
        <p class="ea-eyebrow">Radio por internet · música andina las 24 horas</p>
        <h1 class="ea-h1" id="titulo">Estampas Andinas</h1>
        <p class="ea-tagline">
          Música andina, huaynos tarmeños y más.<span class="ea-tagline-desktop"> Con Orestes Damián.</span>
        </p>

        <div class="ea-livebox ea-panel" data-livebox hidden>
          <span class="ea-livebox-kicker"><span class="ea-live-dot ea-pulse"></span>EN VIVO AHORA</span>
          <span class="ea-livebox-text"
            ><span data-live-who>Orestes Damián</span> está al aire. Manda tu saludo o pedido desde el botón verde de abajo.</span
          >
        </div>
        <p class="ea-nextline" data-nextline>
          Ahora: música continua · Próximo en vivo: <strong data-next>domingo 7:00 a. m.</strong>
        </p>

        <div class="ea-sharebar">
          <span class="ea-sharebar-label">Comparte la radio:</span>
          {
            social.map((s) => (
              <a
                class="ea-share-pill"
                href={s.href}
                target="_blank"
                rel="noopener"
                style={`background: ${s.bg}; color: ${s.fg}`}
              >
                <span set:html={s.icon} />
                <span>{s.label}</span>
              </a>
            ))
          }
          <button type="button" class="ea-copy" data-copy>
            <span set:html={icons.link} />
            <span data-copy-label>Copiar enlace</span>
          </button>
        </div>
      </section>

      <section class="ea-glass ea-m-schedule" aria-label="Horario en vivo">
        <div class="ea-m-kicker" data-m-kicker>Próximo en vivo</div>
        <div class="ea-m-row"><span>Domingos</span><span>7 a 9 a. m.</span></div>
      </section>

      <div class="ea-grid">
        <section id="anteriores" class="ea-panel ea-sheet" data-sheet-panel="episodes" data-needs-episodes aria-labelledby="h-anteriores">
          <div class="ea-panel-head">
            <h2 class="ea-h2" id="h-anteriores">Programas anteriores</h2>
            <button type="button" class="ea-close" data-close aria-label="Cerrar" set:html={icons.close} />
          </div>
          <ol class="ea-list" data-episodes></ol>
          <button type="button" class="ea-more" data-episodes-more hidden>Ver más programas</button>
        </section>

        <section id="recien" class="ea-panel ea-sheet" data-sheet-panel="recent" aria-labelledby="h-recien">
          <div class="ea-panel-head">
            <h2 class="ea-h2" id="h-recien">Sonó recién</h2>
            <button type="button" class="ea-more ea-more-inline" data-history-more hidden>Ver más</button>
            <button type="button" class="ea-close" data-close aria-label="Cerrar" set:html={icons.close} />
          </div>
          <ol class="ea-list" data-history><li class="ea-empty">Cargando…</li></ol>
        </section>

        <section id="programacion" class="ea-panel ea-schedule" aria-labelledby="h-horario">
          <h2 class="ea-h2" id="h-horario">Horario en vivo</h2>
          <div class="ea-schedule-rows">
            <div class="ea-schedule-row"><span>Domingos</span><span>7 a 9 a. m.</span></div>
          </div>
          <p class="ea-schedule-note">
            Con Orestes Damián Navarro. Hora de Perú. Manda tus saludos y pedidos durante el programa.
          </p>
        </section>
      </div>
    </main>

    <PlayerBar />
  </div>
</Layout>

<script>
  import "../scripts/home";
</script>
