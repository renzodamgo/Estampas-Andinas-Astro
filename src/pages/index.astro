---
import Layout from "../layouts/Layout.astro";
import LivePlayer from "../components/home/LivePlayer.astro";
import PastShows from "../components/home/PastShows.astro";
import { RADIO_PUBLIC_PAGE_URL, WHATSAPP_URL } from "../components/radio/config";
import "../styles/home.css";
---

<Layout title="Estampas Andinas por Orestes Damián">
  <div class="ea-page" id="top">
    <div class="ea-first">
      <header class="ea-wrap ea-header">
        <a href="#top" class="ea-logo">Estampas Andinas</a>
        <nav class="ea-nav" aria-label="Principal">
          <a href="#escuchar">Escuchar</a>
          <a href="#programas" data-nav-shows hidden>Programas</a>
          <a href="#programacion">Programación</a>
          <a href={WHATSAPP_URL} class="ea-pill" target="_blank" rel="noopener"
            >Envía tu saludo</a
          >
        </nav>
        <span class="ea-live-chip"
          ><span class="ea-live-dot"></span><span data-status-mirror>AL AIRE</span
          ></span
        >
      </header>

      <main id="escuchar" class="ea-wrap ea-main">
        <section class="ea-hero">
          <div class="ea-eyebrow">
            <span class="ea-live-dot"></span><span>Radio por internet</span>
          </div>
          <h1 class="ea-h1">Estampas Andinas</h1>
          <p class="ea-tagline">Música andina, huaynos tarmeños y más.</p>
          <div class="ea-actions">
            <button type="button" class="ea-btn" data-hero-toggle>
              Escuchar en vivo
            </button>
            <a href="#programacion" class="ea-btn-ghost">Ver horario</a>
          </div>
        </section>

        <section class="ea-player-section" aria-label="Reproductor">
          <LivePlayer />
        </section>
      </main>

      <a
        class="ea-fab"
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener"
        aria-label="Envía tu mensaje por WhatsApp"
      >
        <span class="ea-fab-bubble">Envía tu mensaje por WhatsApp</span>
        <img
          class="ea-fab-icon"
          src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg"
          alt=""
          width="68"
          height="68"
        />
      </a>
    </div>

    <PastShows />

    <section class="ea-wrap ea-lower">
      <div class="ea-col">
        <h2 class="ea-h2">Sonó recién</h2>
        <ol class="ea-history" data-history aria-live="off">
          <li class="ea-empty">Cargando…</li>
        </ol>
        <button type="button" class="ea-more" data-history-more hidden>
          Ver canciones anteriores
        </button>
      </div>

      <div id="programacion" class="ea-col">
        <h2 class="ea-h2">Programación</h2>
        <div class="ea-card ea-glass">
          <div class="ea-kicker">En vivo</div>
          <div class="ea-slot">Todos los domingos, 7 a 9 a. m.</div>
          <div class="ea-note">
            Estampas Andinas con Orestes Damián Navarro. Hora de Perú.
          </div>
        </div>
        <div class="ea-card ea-card-wa ea-glass">
          <div>
            <div class="ea-wa-title">Saludos y pedidos en vivo</div>
            <div class="ea-wa-sub">Escríbenos durante el programa.</div>
          </div>
          <a href={WHATSAPP_URL} class="ea-wa-btn" target="_blank" rel="noopener"
            >Envía tu mensaje por WhatsApp</a
          >
        </div>
      </div>
    </section>

    <footer class="ea-footer">
      <div class="ea-wrap">
        <span>Estampas Andinas · con Orestes Damián</span>
        <span
          >estampasandinas.com ·
          <a href={RADIO_PUBLIC_PAGE_URL} target="_blank" rel="noopener"
            >Reproductor alternativo</a
          ></span
        >
      </div>
    </footer>
  </div>
</Layout>
