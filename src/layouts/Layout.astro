---
import SpeedInsights from "@vercel/speed-insights/astro";
import "../styles/global.css";
import "@fontsource-variable/josefin-slab";
import fontUrl from "@fontsource-variable/josefin-slab/files/josefin-slab-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
}
const siteUrl = "https://www.estampasandinas.com";
const {
  title,
  description = "Radio por internet con música andina y huaynos tarmeños las 24 horas. Programa en vivo todos los domingos de 7 a 9 a. m. con Orestes Damián.",
} = Astro.props;
const canonical = `${siteUrl}/`;
const shareImage = `${siteUrl}/og-image.jpg`;
const imageAlt = "Estampas Andinas: radio por internet de música andina y huaynos, con una foto de los Andes";

// Structured data so search engines understand what the site is.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: canonical,
      name: "Estampas Andinas",
      description,
      inLanguage: "es-PE",
      publisher: { "@id": `${siteUrl}/#radio` },
    },
    {
      "@type": "RadioStation",
      "@id": `${siteUrl}/#radio`,
      name: "Estampas Andinas",
      alternateName: "Estampas Andinas Radio",
      url: canonical,
      description,
      slogan: "Música andina, huaynos tarmeños y más",
      image: shareImage,
      logo: `${siteUrl}/icon-512.png`,
      inLanguage: "es-PE",
      areaServed: "PE",
      genre: ["Música andina", "Huayno", "Folklore peruano"],
      employee: { "@type": "Person", name: "Orestes Damián Navarro", jobTitle: "Conductor" },
      potentialAction: {
        "@type": "ListenAction",
        target: { "@type": "EntryPoint", urlTemplate: canonical, actionPlatform: ["http://schema.org/DesktopWebPlatform", "http://schema.org/MobileWebPlatform"] },
      },
    },
  ],
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content="Orestes Damián Navarro" />
    <meta name="theme-color" content="#11151b" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Estampas Andinas" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://radio.estampasandinas.com" crossorigin />
    <link rel="preconnect" href="https://radio.estampasandinas.com" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // 2G or Data Saver: skip the background photo to save data.
      try {
        var c = navigator.connection;
        if (c && (c.saveData || /(^|-)2g$/.test(c.effectiveType))) {
          document.documentElement.className += " ea-lite";
        }
      } catch (e) {}
    </script>
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
    <SpeedInsights />
  </body>
</html>

<style is:global>
  :root {
  }
  html {
    font-family: system-ui, sans-serif;
  }
  body {
    width: 100vw;
    min-height: 100vh;
    overflow-x: hidden;
  }

  h1,
  p {
    font-family: "Josefin Slab Variable", serif;
  }
</style>
