---
import SpeedInsights from "@vercel/speed-insights/astro";
interface Props {
  title: string;
}
import "@fontsource-variable/josefin-slab";
import fontUrl from "@fontsource-variable/josefin-slab/files/josefin-slab-latin-wght-normal.woff2?url";
const { title } = Astro.props;
const siteUrl = "https://www.estampasandinas.com";
const description =
  "Radio por internet de música andina y huaynos tarmeños. Todos los domingos de 7 a 9 a. m. con Orestes Damián.";
const shareImage = `${siteUrl}/og-image.jpg`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11151b" />
    <link rel="preconnect" href="https://radio.estampasandinas.com" crossorigin />
    <link rel="preconnect" href="https://radio.estampasandinas.com" />
    <link
      rel="preload"
      href={fontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // 2G or Data Saver: skip the background photo to save data.
      try {
        var c = navigator.connection;
        if (c && (c.saveData || /(^|-)2g$/.test(c.effectiveType))) {
          document.documentElement.className += " ea-lite";
        }
      } catch (e) {}
    </script>
    <link rel="canonical" href={siteUrl + "/"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Estampas Andinas" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:url" content={siteUrl + "/"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<SpeedInsights />

<style is:global>
  :root {
  }
  html {
    font-family: system-ui, sans-serif;
  }
  body {
    width: 100vw;
    min-height: 100vh;
    overflow-x: hidden;
  }

  h1,
  p {
    font-family: "Josefin Slab Variable", serif;
  }
</style>
