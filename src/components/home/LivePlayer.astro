---
import fallbackArt from "../../../public/Assets/logo-art.webp";
import { NOW_PLAYING_URL, STREAM_URL } from "../radio/config";
---

<div
  class="ea-player ea-glass"
  data-live-player
  data-now-playing-url={NOW_PLAYING_URL}
  data-stream-url={STREAM_URL}
>
  <div class="ea-track">
    <div class="ea-art">
      <img
        data-art
        class="ea-art-fallback"
        src={fallbackArt.src}
        alt=""
        width="88"
        height="88"
      />
    </div>
    <div class="ea-track-info">
      <div class="ea-status-row">
        <span class="ea-status" data-status>AL AIRE</span>
        <div class="ea-eq" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
      </div>
      <div class="ea-title" data-title>Estampas Andinas</div>
      <div class="ea-sub">
        <span data-artist>Música andina, huaynos tarmeños y más</span>
        <span class="ea-listeners-desktop" data-listeners-desktop></span>
      </div>
      <div class="ea-next ea-next-mobile" data-next></div>
    </div>
  </div>

  <div class="ea-progress-wrap">
    <div class="ea-bar" aria-hidden="true"><div data-progress></div></div>
    <div class="ea-times">
      <span data-elapsed>0:00</span>
      <span class="ea-listeners-mobile" data-listeners-mobile></span>
      <span data-duration>0:00</span>
    </div>
  </div>

  <div class="ea-controls">
    <span class="ea-spacer"></span>
    <button
      type="button"
      class="ea-play"
      data-toggle
      aria-label="Reproducir"
    >
      <svg
        class="ea-icon-play"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M8 5 L19 12 L8 19 Z" fill="currentColor"></path>
      </svg>
      <svg
        class="ea-icon-pause"
        width="26"
        height="26"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"
        ></rect>
        <rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"
        ></rect>
      </svg>
    </button>
    <button
      type="button"
      class="ea-share"
      data-share
      aria-label="Compartir la radio"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3v12"></path>
        <path d="M7 8l5-5 5 5"></path>
        <path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"></path>
      </svg>
    </button>
    <label class="ea-vol" for="ea-volume">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 9h4l5-4v14l-5-4H4z"></path>
        <path d="M16.5 8.5a5 5 0 0 1 0 7"></path>
      </svg>
      <span class="ea-sr">Volumen</span>
      <input id="ea-volume" type="range" min="0" max="100" value="80" data-volume />
    </label>
  </div>
  <label class="ea-saver" data-saver hidden>
    <input type="checkbox" data-saver-input />
    <span>Ahorro de datos<span class="ea-saver-detail" data-saver-label></span></span>
  </label>
  <div class="ea-msg" role="status" aria-live="polite" data-message></div>
</div>

<section class="ea-mini" data-mini aria-label="Reproductor compacto">
  <img class="ea-mini-art ea-art-fallback" data-mini-art src={fallbackArt.src} alt="" width="44" height="44" />
  <button type="button" class="ea-mini-text" data-mini-scroll aria-label="Volver al reproductor">
    <span class="ea-mini-title" data-mini-title>Estampas Andinas</span>
    <span class="ea-mini-sub" data-mini-sub>MÚSICA 24 H</span>
  </button>
  <button type="button" class="ea-mini-btn" data-mini-toggle aria-label="Reproducir">
    <svg class="ea-icon-play" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5 L19 12 L8 19 Z" fill="currentColor"></path></svg>
    <svg class="ea-icon-pause" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"></rect><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"></rect></svg>
  </button>
</section>

<script>
  type Song = {
    title?: string;
    artist?: string;
    text?: string;
    art?: string;
  };
  type HistoryItem = { played_at: number; song: Song };

  const FALLBACK_ART = document
    .querySelector<HTMLImageElement>("[data-art]")!
    .getAttribute("src")!;

  // Network Information API (Chrome/Android). Missing elsewhere, so every check is optional.
  const conn = (navigator as unknown as { connection?: { saveData?: boolean; effectiveType?: string } })
    .connection;
  const slowNet = () =>
    !!conn && (!!conn.saveData || /(^|-)[23]g$/.test(conn.effectiveType || ""));
  const verySlowNet = () =>
    !!conn && (!!conn.saveData || /(^|-)2g$/.test(conn.effectiveType || ""));
  const store = {
    get(k: string) {
      try {
        return localStorage.getItem(k);
      } catch {
        return null;
      }
    },
    set(k: string, v: string) {
      try {
        localStorage.setItem(k, v);
      } catch {
        /* private mode */
      }
    },
  };

  const root = document.querySelector<HTMLElement>("[data-live-player]");
  if (root) init(root);

  function init(root: HTMLElement) {
    const nowPlayingUrl = root.dataset.nowPlayingUrl!;
    const streamUrl = root.dataset.streamUrl!;
    const $ = <T extends HTMLElement>(sel: string) =>
      root.querySelector<T>(`[${sel}]`)!;
    const page = document.querySelector<HTMLElement>(".ea-page") ?? root;

    const artEl = $<HTMLImageElement>("data-art");
    const titleEl = $("data-title");
    const artistEl = $("data-artist");
    const statusEl = $("data-status");
    const progressEl = $("data-progress");
    const elapsedEl = $("data-elapsed");
    const durationEl = $("data-duration");
    const volumeEl = $<HTMLInputElement>("data-volume");
    const toggleEl = $<HTMLButtonElement>("data-toggle");
    const shareEl = $<HTMLButtonElement>("data-share");
    const messageEl = $("data-message");
    const listenersEls = [
      $("data-listeners-desktop"),
      $("data-listeners-mobile"),
    ];
    const mini = document.querySelector<HTMLElement>("[data-mini]")!;
    const miniArt = mini.querySelector<HTMLImageElement>("[data-mini-art]")!;
    const miniTitle = mini.querySelector<HTMLElement>("[data-mini-title]")!;
    const miniSub = mini.querySelector<HTMLElement>("[data-mini-sub]")!;
    const miniToggle = mini.querySelector<HTMLButtonElement>("[data-mini-toggle]")!;
    const heroButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-hero-toggle]"),
    );
    const historyList = document.querySelector<HTMLElement>("[data-history]");
    const moreBtn = document.querySelector<HTMLButtonElement>(
      "[data-history-more]",
    );
    const VISIBLE_SONGS = 5;
    let historyExpanded = false;
    let lastHistory: HistoryItem[] = [];

    let online = true;
    let isLive = false;
    let streamer = "";
    let playing = false;
    let loading = false;
    let duration = 0;
    let baseElapsed = 0;
    let fetchedAt = Date.now();
    let currentId: string | number | null = null;
    let currentArt: string | null = null;

    const audio = new Audio();
    audio.preload = "none";

    // Optional lower-bitrate mount ("Ahorro de datos"), discovered from the API.
    const saverEl = $("data-saver");
    const saverInput = $<HTMLInputElement>("data-saver-input");
    const saverLabel = $("data-saver-label");
    let defaultStream = streamUrl;
    let lowMount: { url: string; bitrate: number } | null = null;
    const saverPref = () => store.get("ea-saver"); // "1", "0" or null (= automatic)
    const useSaver = () =>
      saverPref() === "1" || (saverPref() === null && slowNet());
    const currentStream = () =>
      useSaver() && lowMount ? lowMount.url : defaultStream;

    // ---------- helpers ----------
    const fmt = (s: number) => {
      s = Math.max(0, Math.floor(s));
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
    };

    const artCache = new Map<string, Promise<string | null>>();
    // AzuraCast answers with its own generic cover when a song has no art.
    // Resolve it once and fall back to our logo in that case.
    function resolveArt(url?: string): Promise<string | null> {
      if (!url || verySlowNet()) return Promise.resolve(null);
      let hit = artCache.get(url);
      if (!hit) {
        hit = fetch(url)
          .then(async (res) => {
            if (!res.ok || res.url.includes("generic_song")) {
              if (res.body && res.body.cancel) void res.body.cancel();
              return null;
            }
            return URL.createObjectURL(await res.blob());
          })
          .catch(() => null);
        artCache.set(url, hit);
      }
      return hit;
    }

    function setArt(img: HTMLImageElement, resolved: string | null) {
      if (resolved) {
        img.src = resolved;
        img.classList.remove("ea-art-fallback");
      } else {
        img.src = FALLBACK_ART;
        img.classList.add("ea-art-fallback");
      }
    }

    function renderState() {
      page.classList.toggle("is-playing", playing);
      const label = loading
        ? "Conectando…"
        : playing
          ? "Pausar"
          : "Escuchar en vivo";
      heroButtons.forEach((b) => (b.textContent = label));
      toggleEl.setAttribute("aria-label", playing ? "Pausar" : "Reproducir");
      toggleEl.setAttribute("aria-busy", String(loading));
      const statusLabel = !online
        ? "FUERA DE LÍNEA"
        : isLive
          ? "EN VIVO"
          : "MÚSICA 24 H";
      statusEl.textContent = statusLabel;
      miniSub.textContent = statusLabel;
      miniToggle.setAttribute("aria-label", playing ? "Pausar" : "Reproducir");
      statusEl.classList.toggle("is-offline", !online);
      statusEl.classList.toggle("is-live", online && isLive);
      page.classList.toggle("is-live", online && isLive);
      document
        .querySelectorAll<HTMLElement>("[data-status-mirror]")
        .forEach((el) => (el.textContent = statusLabel));
      document.querySelectorAll<HTMLElement>("[data-eyebrow]").forEach((el) => {
        el.textContent =
          online && isLive
            ? `En vivo ahora${streamer ? ` con ${streamer}` : ""}`
            : "Radio por internet";
      });
      renderNext();
    }

    // Next broadcast: Sundays 7:00-9:00 (Peru time, UTC-5, no daylight saving).
    function renderNext() {
      let text: string;
      if (online && isLive) {
        text = "Estamos en vivo ahora.";
      } else {
        const lima = new Date(Date.now() - 5 * 3600 * 1000);
        const day = lima.getUTCDay();
        const mins = lima.getUTCHours() * 60 + lima.getUTCMinutes();
        if (day === 0 && mins >= 7 * 60 && mins < 9 * 60) {
          text = "El programa de hoy es de 7 a 9 a. m.";
        } else {
          let diff = ((7 - day) % 7) * 1440 + 7 * 60 - mins;
          if (diff <= 0) diff += 7 * 1440;
          const d = Math.floor(diff / 1440);
          const h = Math.floor((diff % 1440) / 60);
          const m = diff % 60;
          const wait = d > 0 ? `${d} d ${h} h` : h > 0 ? `${h} h ${m} min` : `${m} min`;
          text = `Próximo programa: domingo 7:00 a. m. · en ${wait}`;
        }
      }
      document
        .querySelectorAll<HTMLElement>("[data-next]")
        .forEach((el) => (el.textContent = text));
    }

    function renderProgress() {
      const elapsed = Math.min(
        duration || Infinity,
        baseElapsed + (Date.now() - fetchedAt) / 1000,
      );
      elapsedEl.textContent = fmt(elapsed);
      durationEl.textContent = duration ? fmt(duration) : "";
      progressEl.style.width = duration
        ? `${Math.min(100, (elapsed / duration) * 100)}%`
        : "0%";
    }

    // ---------- playback ----------
    async function play(auto = false) {
      messageEl.textContent = "";
      messageEl.classList.remove("is-error");
      page.classList.remove("needs-tap");
      loading = true;
      renderState();
      // Reload so we join the live edge instead of resuming a stale buffer.
      audio.src = `${currentStream()}?t=${Date.now()}`;
      try {
        await audio.play();
      } catch {
        loading = false;
        playing = false;
        audio.removeAttribute("src");
        messageEl.textContent = auto
          ? "Toca el botón verde para escuchar."
          : "No se pudo reproducir. Intenta de nuevo en unos segundos.";
        messageEl.classList.toggle("is-error", !auto);
        page.classList.toggle("needs-tap", auto);
        renderState();
        if (auto) armFirstGesture();
      }
    }

    function stop() {
      userStopped = true;
      page.classList.remove("needs-tap");
      disarmFirstGesture();
      audio.pause();
      audio.removeAttribute("src");
      audio.load();
      playing = false;
      loading = false;
      renderState();
    }

    // Browsers block sound until the visitor interacts with the page, so when
    // autoplay is refused we start on the first tap or key press instead.
    let userStopped = false;
    function onFirstGesture(e: Event) {
      const target = e.target as Element | null;
      if (target?.closest(
          "[data-toggle], [data-hero-toggle], [data-mini-toggle], [data-share], [data-episode-play]",
        )) {
        disarmFirstGesture();
        return;
      }
      disarmFirstGesture();
      if (!userStopped && !playing && !loading) void play();
    }
    function armFirstGesture() {
      document.addEventListener("pointerdown", onFirstGesture, { once: true });
      document.addEventListener("keydown", onFirstGesture, { once: true });
    }
    function disarmFirstGesture() {
      document.removeEventListener("pointerdown", onFirstGesture);
      document.removeEventListener("keydown", onFirstGesture);
    }

    const toggle = () => {
      disarmFirstGesture();
      if (playing || loading) stop();
      else {
        userStopped = false;
        void play();
      }
    };

    audio.addEventListener("playing", () => {
      page.classList.remove("needs-tap");
      loading = false;
      playing = true;
      renderState();
      window.dispatchEvent(new CustomEvent("ea:live-playing"));
    });
    window.addEventListener("ea:episode-playing", () => {
      if (playing || loading) stop();
      else {
        userStopped = true;
        disarmFirstGesture();
      }
    });
    audio.addEventListener("error", () => {
      if (!audio.getAttribute("src")) return;
      stop();
      messageEl.textContent =
        "Se cortó la transmisión. Presiona reproducir para reconectar.";
      messageEl.classList.add("is-error");
    });

    toggleEl.addEventListener("click", toggle);
    miniToggle.addEventListener("click", toggle);
    mini
      .querySelector("[data-mini-scroll]")!
      .addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: "smooth" }),
      );
    heroButtons.forEach((b) => b.addEventListener("click", toggle));

    // ---------- volume ----------
    const savedVolume = Number(store.get("ea-volume"));
    if (!Number.isNaN(savedVolume) && store.get("ea-volume")) {
      volumeEl.value = String(savedVolume);
    }
    audio.volume = Number(volumeEl.value) / 100;
    volumeEl.addEventListener("input", () => {
      audio.volume = Number(volumeEl.value) / 100;
      store.set("ea-volume", volumeEl.value);
    });

    // ---------- data saver ----------
    saverInput.addEventListener("change", () => {
      store.set("ea-saver", saverInput.checked ? "1" : "0");
      if (playing || loading) void play(); // restart on the other mount
    });

    // ---------- share ----------
    shareEl.addEventListener("click", async () => {
      const data = {
        title: "Estampas Andinas",
        text: "Música andina, huaynos tarmeños y más.",
        url: location.origin,
      };
      try {
        if (navigator.share) await navigator.share(data);
        else {
          await navigator.clipboard.writeText(data.url);
          messageEl.textContent = "Enlace copiado.";
        }
      } catch {
        /* user cancelled */
      }
    });

    // ---------- Media Session (lock screen controls) ----------
    function updateMediaSession(title: string, artist: string) {
      if (!("mediaSession" in navigator)) return;
      navigator.mediaSession.metadata = new MediaMetadata({
        title,
        artist: artist || "Estampas Andinas",
        album: "Estampas Andinas",
        artwork: currentArt
          ? [{ src: currentArt, sizes: "512x512" }]
          : [{ src: FALLBACK_ART, sizes: "512x512", type: "image/webp" }],
      });
      navigator.mediaSession.setActionHandler("play", () => void play());
      navigator.mediaSession.setActionHandler("pause", () => stop());
    }

    // ---------- now playing ----------
    const dateFmt = new Intl.DateTimeFormat("es-PE", {
      day: "numeric",
      month: "short",
      timeZone: "America/Lima",
    });
    const timeFmt = new Intl.DateTimeFormat("es-PE", {
      hour: "numeric",
      minute: "2-digit",
      timeZone: "America/Lima",
    });
    function ago(playedAt: number) {
      const mins = Math.round((Date.now() / 1000 - playedAt) / 60);
      if (mins < 1) return "ahora";
      if (mins < 60) return `hace ${mins} min`;
      const hours = Math.round(mins / 60);
      if (hours < 24) return `hace ${hours} h`;
      const d = new Date(playedAt * 1000);
      return `${dateFmt.format(d)}, ${timeFmt.format(d)}`;
    }

    function renderHistory(items: HistoryItem[]) {
      lastHistory = items;
      if (!historyList) return;
      historyList.textContent = "";
      if (!items.length) {
        const li = document.createElement("li");
        li.className = "ea-empty";
        li.textContent = "Todavía no hay canciones en el historial.";
        historyList.append(li);
        if (moreBtn) moreBtn.hidden = true;
        return;
      }
      items.forEach((item, index) => {
        const li = document.createElement("li");
        li.className = "ea-row";
        li.hidden = !historyExpanded && index >= VISIBLE_SONGS;

        const thumb = document.createElement("div");
        thumb.className = "ea-thumb";
        const img = document.createElement("img");
        img.alt = "";
        img.loading = "lazy";
        setArt(img, null);
        thumb.append(img);
        if (!li.hidden) {
          void resolveArt(item.song.art).then((r) => r && setArt(img, r));
        }

        const text = document.createElement("div");
        text.className = "ea-row-text";
        const title = document.createElement("div");
        title.className = "ea-row-title";
        title.textContent = item.song.title || item.song.text || "—";
        text.append(title);
        if (item.song.artist) {
          const artist = document.createElement("div");
          artist.className = "ea-row-artist";
          artist.textContent = item.song.artist;
          text.append(artist);
        }

        const time = document.createElement("div");
        time.className = "ea-row-time";
        time.textContent = ago(item.played_at);

        li.append(thumb, text, time);
        historyList.append(li);
      });

      if (moreBtn) {
        const extra = items.length - VISIBLE_SONGS;
        moreBtn.hidden = extra <= 0;
        moreBtn.textContent = historyExpanded
          ? "Ver menos"
          : `Ver ${extra} canciones anteriores`;
        moreBtn.setAttribute("aria-expanded", String(historyExpanded));
      }
    }

    moreBtn?.addEventListener("click", () => {
      historyExpanded = !historyExpanded;
      renderHistory(lastHistory);
    });

    async function refresh() {
      try {
        const res = await fetch(nowPlayingUrl, { cache: "no-store" });
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();
        online = Boolean(data.is_online);
        isLive = Boolean(data.live?.is_live);
        streamer = String(data.live?.streamer_name ?? "");

        const mounts = (data.station?.mounts ?? []) as {
          url: string;
          bitrate: number;
          is_default?: boolean;
        }[];
        const def = mounts.find((m) => m.is_default) ?? mounts[0];
        if (def) defaultStream = def.url;
        lowMount =
          (def &&
            mounts
              .filter((m) => m !== def && m.bitrate && m.bitrate < def.bitrate)
              .sort((a, b) => a.bitrate - b.bitrate)[0]) ||
          null;
        saverEl.hidden = !lowMount;
        if (lowMount) {
          saverLabel.textContent = ` · ${lowMount.bitrate} kbps`;
          saverInput.checked = useSaver();
        }

        const np = data.now_playing ?? {};
        const song: Song = np.song ?? {};
        const title = song.title || song.text || "Estampas Andinas";
        const artist = song.artist || "";
        duration = Number(np.duration) || 0;
        baseElapsed = Number(np.elapsed) || 0;
        fetchedAt = Date.now();

        if (np.sh_id !== currentId) {
          currentId = np.sh_id;
          titleEl.textContent = title;
          artistEl.textContent = artist || "Estampas Andinas";
          const resolved = await resolveArt(song.art);
          currentArt = resolved;
          setArt(artEl, resolved);
          setArt(miniArt, resolved);
          miniTitle.textContent = title;
          updateMediaSession(title, artist);
        }

        const n = Number(data.listeners?.current) || 0;
        const text = n > 0 ? `${n} escuchando` : "";
        listenersEls.forEach((el) => {
          el.textContent = text;
        });
        const desktop = listenersEls[0];
        desktop.textContent = text ? ` · ${text}` : "";

        renderHistory(
          (data.song_history as HistoryItem[] | undefined)?.slice(0, 30) ?? [],
        );
      } catch {
        // Keep the last known state; the next poll will retry.
      }
      renderState();
      renderProgress();
    }

    // Show the compact bar once the main player has scrolled out of view,
    // unless an episode is playing (the bar only controls the live stream).
    let playerInView = true;
    let episodeMode = false;
    const syncMini = () =>
      mini.classList.toggle("is-visible", !playerInView && !episodeMode);
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          playerInView = entry.isIntersecting;
          syncMini();
        },
        { threshold: 0.05 },
      ).observe(root);
    }
    window.addEventListener("ea:episode-playing", () => {
      episodeMode = true;
      syncMini();
    });
    window.addEventListener("ea:live-playing", () => {
      episodeMode = false;
      syncMini();
    });

    renderState();
    const firstRefresh = refresh();
    const startAudio = () => {
      void firstRefresh.then(() => {
        if (verySlowNet()) {
          messageEl.textContent = "Ahorro de datos: toca el botón verde para escuchar.";
          page.classList.add("needs-tap");
        } else {
          void play(true);
        }
      });
    };
    // Let the page and the photo finish loading before the stream competes for bandwidth.
    if (document.readyState === "complete") startAudio();
    else window.addEventListener("load", startAudio);
    setInterval(() => {
      if (document.hidden && !playing) return;
      void refresh();
    }, 15_000);
    setInterval(renderProgress, 1000);
    setInterval(renderNext, 30_000);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) void refresh();
    });
  }
</script>
